{
  "version": "2026-10-09",
  "entries": {
    "web": "/system/function-params",
    "businessRules": "/system/business-rules",
    "storageKeysDemo": ["i_doms_function_params", "i_doms_business_rules"]
  },
  "params": [
    {
      "key": "salaryPushMode",
      "label": "工资推送模式",
      "category": "production",
      "default": "manual",
      "options": [
        { "value": "on_report", "label": "报工即推送", "effect": "报工后工人可在工时工资查看" },
        { "value": "on_audit", "label": "审核后推送", "effect": "审核通过后工人可见" },
        { "value": "manual", "label": "手动推送", "effect": "需在工资核算中手动推送后可见" }
      ],
      "faq": ["工人报完工看不到工资", "审核了为什么还没有工资"],
      "legacyNote": "历史值 auto 在 Web 常归一为 on_report"
    },
    {
      "key": "inventoryDeductMode",
      "label": "库存扣减方式",
      "category": "inventory",
      "audience": "internal",
      "default": "no_issue",
      "options": [
        {
          "value": "no_issue",
          "label": "不领料（极简报工 / 无工单）",
          "effect": "不生成工单完工库存扣减"
        },
        {
          "value": "post_complete_by_report",
          "label": "完工后预扣+确认（无领料，按BOM×完工数扣发料仓）",
          "effect": "须人工确认，不可自动确认"
        },
        {
          "value": "self_issue_by_actual",
          "label": "自主领料+完工后预扣+确认（扣线边仓）",
          "effect": "领料发料仓→线边；完工扣线边；可自动确认；库存不足失败"
        }
      ],
      "customerWording": "按领料/报工习惯保证账实一致，日常把领料和入库做对即可"
    },
    {
      "key": "productionMode",
      "label": "生产模式",
      "store": "business-rules",
      "options": [
        { "value": "standard", "label": "标准模式" },
        { "value": "minimal", "label": "极简报工", "childKey": "minimalReportType" },
        { "value": "minimal_salary", "label": "下发即报工" }
      ],
      "childOptions": {
        "minimalReportType": [
          { "value": "quick", "label": "快速报工" },
          { "value": "task", "label": "任务报工" }
        ]
      },
      "note": "极简下快速与任务互斥"
    },
    {
      "key": "autoApproveDocs",
      "label": "自动审批",
      "category": "automation",
      "flags": [
        "purchaseOrder",
        "salesOrder",
        "salesOrderPriceChange",
        "purchaseOrderPriceChange",
        "outsourcingOrderPriceChange",
        "outsourcingOrder",
        "finishedInbound",
        "materialRequisition",
        "inventoryDeduct",
        "scrapOrder"
      ],
      "constraints": [
        "inventoryDeduct 自动确认仅对 self_issue_by_actual 生效",
        "post_complete_by_report 永远人工确认",
        "scrapOrder 配置项可能已展示但业务侧未完全接入"
      ]
    },
    {
      "key": "autoGenerateDocs",
      "label": "自动生成单据",
      "category": "automation",
      "trigger": "销售订单审核通过后按供应型态",
      "flags": [
        { "value": "purchaseRequisition", "label": "采购申请单" },
        { "value": "outsourcingOrder", "label": "外协订单" },
        { "value": "productionWorkOrder", "label": "生产工单" },
        { "value": "assemblyWorkOrder", "label": "总装/部装工单" }
      ],
      "implementTip": "供应型态未清洗前建议全关"
    },
    {
      "key": "outboundIssueRule",
      "label": "出库规则",
      "category": "inventory",
      "options": [
        { "value": "fifo", "label": "先进先出", "enabled": true },
        { "value": "lifo", "label": "后进先出", "enabled": false },
        { "value": "manual", "label": "自主拣选", "enabled": false }
      ],
      "appliesTo": ["领料", "外协发料"]
    },
    {
      "key": "salesOutboundIssueRule",
      "label": "发货出库规则",
      "category": "inventory",
      "options": [
        { "value": "by_order", "label": "按单发货" },
        { "value": "fifo", "label": "先进先出（FIFO）" }
      ],
      "appliesTo": ["销售发货"]
    },
    {
      "key": "shipAttachmentDecideStage",
      "label": "随货附件确定时机",
      "options": [
        { "value": "apply", "label": "申请发货时确定" },
        { "value": "warehouse", "label": "仓管发货时确定" }
      ]
    },
    {
      "key": "transferRequireInboundConfirm",
      "label": "调拨是否需入库方签收",
      "type": "boolean"
    },
    {
      "key": "stocktakeAutoPostOnApprove",
      "label": "盘点审核通过后自动过账",
      "type": "boolean"
    },
    {
      "key": "dualUnitIssueStrategy",
      "label": "下料结算策略",
      "options": [
        { "value": "partial", "label": "无需下料结算（余料留线边仓）" },
        { "value": "whole_with_remnant", "label": "需下料结算（余料回库）" }
      ]
    },
    {
      "key": "enableBomLevelMts",
      "label": "BOM级MTS",
      "type": "boolean",
      "default": false
    },
    {
      "key": "qcGatePolicyByBizScope",
      "label": "质检门控",
      "category": "quality",
      "scopes": ["来料质检", "外协回货检", "生产过程检", "成品检", "出厂质检"],
      "options": [
        { "value": "soft", "label": "弱管控（仅预警）", "enabled": true },
        { "value": "hard", "label": "强管控（阻断下游）", "enabled": false }
      ]
    },
    {
      "key": "blankSizeAssistTools",
      "label": "下料/订货尺寸辅助",
      "flags": [
        { "value": "plateAreaMeasure", "label": "面积换算" },
        { "value": "bomWeightCalc", "label": "重量计算" }
      ]
    }
  ],
  "sceneParamChecklist": {
    "S1": ["salaryPushMode", "productionMode"],
    "S2": [
      "salaryPushMode",
      "inventoryDeductMode",
      "autoApproveDocs.materialRequisition",
      "autoApproveDocs.finishedInbound"
    ],
    "S3": ["productionMode", "inventoryDeductMode", "salaryPushMode"],
    "S4": ["autoGenerateDocs", "salesOutboundIssueRule", "salaryPushMode", "inventoryDeductMode"],
    "S5": ["qcGatePolicyByBizScope", "autoApproveDocs.scrapOrder"]
  }
}
